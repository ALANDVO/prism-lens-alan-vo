# ─── Environment Configuration ───────────────────────────────────────────
# Copy to .env and fill in values. DO NOT commit the .env file.

# Application
ENVIRONMENT=development
DEBUG=false

# Database (SQLite — set to a file path for persistent storage)
DATABASE_URL=sqlite+aiosqlite:///./prism_lens.db
DATA_DIR=./data

# Authentication (Keycloak OIDC)
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=prism-lens
KEYCLOAK_CLIENT_ID=prism-lens
OIDC_REDIRECT_URI=http://localhost:5173/callback
DEV_MODE=true

# LLM Advisory (opt-in — leave blank to disable)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Upload
UPLOAD_MAX_BYTES=50000000